{
	"name": "food-assistant-bot",
	"module": "src/server.ts",
	"type": "module",
	"private": true,
	"engines": {
		"bun": ">=1.4.2"
	},
	"scripts": {
		"start:server": "bun src/server.ts",
		"start:worker": "bun src/worker.ts",

		"dev:server": "bun --watch src/server.ts",
		"dev:worker": "bun --watch src/worker.ts",

		"migration:generate": "bunx drizzle-kit generate",
		"migrate": "bunx drizzle-kit migrate",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@types/bun": "^1.4.1",
		"@types/pg": "^8.23.1",
		"drizzle-kit": "^0.31.10",
		"pino-pretty": "^13.1.3",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"@openrouter/ai-sdk-provider": "^3.0.0",
		"@sentry/bun": "^10.73.0",
		"ai": "^7.0.93",
		"bullmq": "^6.3.4",
		"drizzle-orm": "^0.45.2",
		"grammy": "^1.46.0",
		"pg": "^8.23.0",
		"pino": "^10.3.1",
		"zod": "^4.5.4"
	}
}
